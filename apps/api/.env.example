# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# Origin(s) allowed for CORS — comma-separated. Tighten before production.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Change to a cryptographically random 256-bit value before production.
JWT_SECRET=CHANGE_ME_BEFORE_PRODUCTION_use_openssl_rand_hex_32

# Session token lifetime in seconds. Default: 1800 (30 min).
JWT_SESSION_EXPIRY_SECONDS=1800

# ─── Twilio SMS Gateway ───────────────────────────────────────────────────────
# Leave ALL THREE blank to activate the console-log stub (safe for local dev).
# Populate all three with real Twilio credentials to enable live SMS delivery.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Patient Scan Link ────────────────────────────────────────────────────────
# Base URL that the patient opens to start their scan session.
# The server appends ?token=<JWT> automatically.
PATIENT_SCAN_BASE_URL=http://localhost:5173/scan

# ─── Database (Prisma / PostgreSQL) ───────────────────────────────────────────
# Transaction-mode pooler — used by the app at runtime (fast, multiplexed).
# For Supabase: Project Settings → Database → Connection Pooling → Transaction mode (port 6543).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Session-mode pooler — used by Prisma CLI (db push / generate) for DDL.
# For Supabase: same pooler host but port 5432 (Session mode). Avoids PgBouncer DDL hang.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Session-creation limiter: max requests per window per IP.
RATE_LIMIT_SESSION_MAX=10
RATE_LIMIT_SESSION_WINDOW_MS=900000

# General API limiter: max requests per window per IP.
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_GENERAL_WINDOW_MS=60000
